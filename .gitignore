# --- Environment / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / React / frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Screenshots ---
# LIVE captures are throwaway/local -- never committed. DEMO fixtures are
# committed on purpose: the demo capture path needs them to work on a
# fresh clone with no network access.
screenshots/live/*
!screenshots/live/.gitkeep

# --- Logs ---
logs/*
!logs/.gitkeep
*.log

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Database ---
*.sqlite3
*.sqlite
*.db
# Pre-migration backups of the real dev database (e.g.
# tradepilot.db.pre-iteration2-backup) don't end in ".db", so *.db above
# doesn't catch them -- they hold the same evidence-run data as the live
# database and must never enter git history either.
*.db.pre-*-backup
