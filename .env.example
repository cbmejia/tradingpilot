# TradePilot AI — environment variable placeholders.
# Copy to .env and fill in real values locally. Never commit .env.
# No real keys are present here.

# --- LLM / Agent provider ---
# Anthropic API key -- get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Screenshot capture (live | demo) ---
CAPTURE_MODE=demo

# --- Market data provider (live | demo) ---
MARKET_DATA_MODE=demo
# Free Alpha Vantage API key -- no paid plan needed, but a free signup is
# required. Get one at https://www.alphavantage.co/support/#api-key
MARKET_DATA_API_KEY=
# Optional override of the API base URL. Leave blank to use Alpha
# Vantage's default (https://www.alphavantage.co/query).
MARKET_DATA_BASE_URL=

# --- Economic calendar provider ---
ECONOMIC_CALENDAR_API_KEY=

# --- TradingView capture ---
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# --- Guardrail thresholds (guardrails/rules.py) ---
# How old a chart screenshot / market quote can be before it's stale.
CAPTURE_MAX_AGE_SECONDS=300
MARKET_DATA_MAX_AGE_SECONDS=900
# Minimum acceptable risk/reward ratio (reward distance / risk distance).
MIN_RISK_REWARD=1.0
# Minimum total evaluation score (0-100) to reach READY_FOR_REVIEW.
# Chosen relative to the uncertainty ceilings (LOW 100 / MEDIUM 76 / HIGH
# 52, see docs/rubric.md): below MEDIUM's ceiling so a genuinely good
# MEDIUM-confidence setup can still pass, but above HIGH's ceiling so a
# HIGH-uncertainty run can never clear this threshold on score alone.
MIN_TOTAL_SCORE=60

# --- Testing controls (Milestone 12) ---
# Off ("false") by default. Set to "true" only when you deliberately want
# to demonstrate a guardrail with POST /runs/{run_id}/analyze's
# force_scenario parameter -- see docs/failure_modes.md. Never turn this
# on for a deployment anyone might mistake for a real one: it has no
# effect on run creation, scoring, or review, only on which synthetic
# result one pipeline stage uses for one deliberately-requested run.
TESTING_CONTROLS_ENABLED=false

# --- Database ---
DATABASE_URL=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=
